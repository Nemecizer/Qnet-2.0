    /^  *[0-9]+ +[^ ]+ / {
      idx=$1+0
      if ($2 !~ /^[-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$/ ||
          $3 !~ /^[-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$/ ||
          $4 !~ /^[-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$/ ||
          idx < 1 || idx > expected || seen[idx]++) bad=1
    }
    END {
      for (i=1; i<=expected; i++) if (!seen[i]) bad=1
      exit bad ? 1 : 0
    }
